# 10XAI — environment variables (all optional)
# Copy to .env if you need to override a default. NEVER commit .env.

# Port the local board listens on (defaults to 8080; config.js also sets this).
PORT=8080

# Verification and execution run through your local `claude` CLI, which manages
# its own authentication — no API key is required here.

# Optional: bill runs to an Anthropic API key instead of your subscription.
# Both lines are required — without TENXAI_USE_API_KEY=1 the key is stripped
# before the `claude` CLI is spawned.
# ANTHROPIC_API_KEY=sk-ant-...
# TENXAI_USE_API_KEY=1
